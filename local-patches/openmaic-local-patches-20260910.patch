+  // undici's defaults cap response headers at 5 minutes and body gaps at 5
+  // minutes. Non-streaming LLM scene generation routinely runs past that on
+  // heavy scene types (interactive HTML simulations on a slow model), dying at
+  // exactly 5:00 with "Headers Timeout Error". Give those requests 15 minutes.
+  try {
+    const { Agent, setGlobalDispatcher } = await import('undici');
+    setGlobalDispatcher(new Agent({ headersTimeout: 900_000, bodyTimeout: 900_000 }));
+  } catch (error) {
+    console.error('[instrumentation] Failed to raise undici timeouts', error);
